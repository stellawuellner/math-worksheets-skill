     "difficulty": 2, "bloom": "apply"},

    {"id": 8, "type": "manual", "slot": "(a) the new equation",
     "desc": "Part (a): the equation must be y = -x^2 + 9. Full credit requires the minus sign in front of the squared term, which is what reflecting in the x-axis does, together with the plus 9 for the upward shift. An answer of y = -(x^2 + 9) is wrong: that reflects the shifted graph instead of shifting the reflected one.",
     "skill": "transformations", "facet": "transformations", "standard": "HSF-BF.B.3",
     "difficulty": 3, "bloom": "apply"},
    {"id": 8, "type": "zeros", "expr": "-x**2 + 9", "expected": [-3, 3],
